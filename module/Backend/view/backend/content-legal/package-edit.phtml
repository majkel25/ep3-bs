        <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 12px;">Change History</h2>

        <?php if (empty($auditHistory)): ?>
            <p class="gray">No changes recorded yet.</p>
        <?php else: ?>
        <table class="default-table" style="width: 100%; font-size: 13px;">
            <thead>
                <tr>
                    <th style="text-align: left; padding: 6px 8px;">Date</th>
                    <th style="text-align: left; padding: 6px 8px;">Admin</th>
                    <th style="text-align: left; padding: 6px 8px;">Fields Changed</th>
                    <th style="text-align: left; padding: 6px 8px;">Summary</th>
                </tr>
            </thead>
            <tbody>
            <?php foreach ($auditHistory as $entry): ?>
                <?php
                $changedFields = [];
                $oldVals = [];
                $newVals = [];
                if (isset($entry['changed_fields_json']) && $entry['changed_fields_json']) {
                    $cf = json_decode((string)$entry['changed_fields_json'], true);
                    if (is_array($cf)) $changedFields = $cf;
                }
                if (isset($entry['old_values_json']) && $entry['old_values_json']) {
                    $ov = json_decode((string)$entry['old_values_json'], true);
                    if (is_array($ov)) $oldVals = $ov;
                }
                if (isset($entry['new_values_json']) && $entry['new_values_json']) {
                    $nv = json_decode((string)$entry['new_values_json'], true);
                    if (is_array($nv)) $newVals = $nv;
                }
                $adminName = (string)($entry['admin_alias'] ?? $entry['admin_name_snapshot'] ?? 'Unknown');

                $summaryParts = [];
                foreach ($changedFields as $field) {
                    $old = $oldVals[$field] ?? '';
                    $new = $newVals[$field] ?? '';
                    $summaryParts[] = $field . ': ' . (string)$old . ' → ' . (string)$new;
                }
                ?>
                <tr>
                    <td style="padding: 6px 8px; white-space: nowrap; color: #888;">
                        <?= $this->e(substr((string)($entry['created_at'] ?? ''), 0, 16)) ?>
                    </td>
                    <td style="padding: 6px 8px;"><?= $this->e($adminName) ?></td>
                    <td style="padding: 6px 8px; color: #555;">
                        <?= $this->e(implode(', ', $changedFields)) ?>
                    </td>
                    <td style="padding: 6px 8px; color: #444;">
                        <?= $this->e(implode('; ', $summaryParts)) ?>
                    </td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
        <?php endif; ?>
