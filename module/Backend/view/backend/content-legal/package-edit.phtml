</div>

<script>
(function () {
    var form = document.getElementById('package-edit-form');
    var submitBtn = document.getElementById('submit-btn');
    var originalPrice = <?= json_encode($priceDisplay) ?>;
    var originalIsPublic = <?= json_encode($isPublic ? '1' : '0') ?>;
    var originalIsActive = <?= json_encode($isActive ? '1' : '0') ?>;

    if (!form) return;

    form.addEventListener('submit', function (e) {
        var priceField = document.getElementById('price');
        var newPrice = priceField ? priceField.value : originalPrice;

        var isPublicRadios = document.querySelectorAll('input[name="isPublic"]');
        var newIsPublic = '0';
        isPublicRadios.forEach(function (r) { if (r.checked) newIsPublic = r.value; });

        var isActiveChk = document.getElementById('isActive');
        var newIsActive = (isActiveChk && isActiveChk.checked) ? '1' : '0';

        // Price changed?
        if (newPrice !== originalPrice) {
            if (!confirm('This changes the price for new assignments and renewals. Existing membership records will not be changed. Continue?')) {
                e.preventDefault();
                return;
            }
        }

        // Visibility changed from public to assigned_only?
        if (originalIsPublic === '1' && newIsPublic === '0') {
            if (!confirm('This package will no longer appear in the general member package catalogue. Members already assigned to it will continue to see their own package. Continue?')) {
                e.preventDefault();
                return;
            }
        }

        // Deactivating?
        if (originalIsActive === '1' && newIsActive === '0') {
            if (!confirm('Deactivating this package will prevent new assignments. Continue?')) {
                e.preventDefault();
                return;
            }
        }

        // Prevent double-submit
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving…';
    });
})();
</script>
